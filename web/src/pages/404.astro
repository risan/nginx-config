---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page not found" description="This page does not exist." path="/404" noindex>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <p class="font-mono text-[13px] text-muted-foreground">404</p>
    <h1 class="mt-1 text-lg font-semibold">Page not found</h1>
    <p class="mt-2 text-[13px] text-muted-foreground">
      The page you asked for does not exist. Go back to the{' '}
      <a href="/" class="underline underline-offset-2">
        config generator
      </a>{' '}
      or read the{' '}
      <a href="/docs/" class="underline underline-offset-2">
        guides
      </a>
      .
    </p>
  </main>
</Layout>
